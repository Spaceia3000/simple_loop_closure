Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /GLOBAL current PGO pose only (tiny magenta arrow; not trajectory)1
        - /GLOBAL corrected 3D RGB map (GTSAM keyframe corrections)1
      Splitter Ratio: 0.5
    Tree Height: 339
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
